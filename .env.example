# Copy to .env and fill in. NEVER commit .env.

ROADMAP_REPO_PATH=
GITHUB_TOKEN=
GITHUB_OWNER=nilbuild
GITHUB_REPO=developer-roadmap
GITHUB_BRANCH=master

APP_ENV=development
SECRET_KEY=
DEBUG=true
HOST=127.0.0.1
PORT=5050
ADMIN_EMAILS=
RUN_SCHEDULERS=true

FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# Production alternative: paste the whole JSON (or its base64) here instead of a file
# FIREBASE_SERVICE_ACCOUNT_JSON=

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

SYNC_ON_STARTUP=true
STALE_AFTER_HOURS=48
SYNC_INTERVAL_HOURS=24
CACHE_TTL=300
REQUEST_TIMEOUT=20
API_DELAY=0.3